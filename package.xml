<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_llm</name>
  <version>1.0.0</version>
  <description>Embodied LLM agent for robotic guidance of persons with visual impairments</description>
  <maintainer email="sangmim@example.com">Sang Min</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS 2 Core Dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>vision_msgs</depend>

  <!-- ROS 2 Utilities -->
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Python Dependencies (for documentation, actual install via pip) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <!-- Additional Python packages installed via pip:
       - torch>=2.0.0
       - torchvision>=0.15.0
       - open-clip-torch>=2.0.0
       - chromadb>=0.4.0
       - anthropic>=0.25.0
       - openai>=1.0.0
       - google-generativeai>=0.3.0
       - groq>=0.4.0
       - numpy>=1.24.0
       - Pillow>=9.0.0
       - tqdm>=4.65.0
       - requests>=2.31.0
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>